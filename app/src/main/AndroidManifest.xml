<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed only for downloading offline Vosk language models -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app update installs (unknown sources) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".FlamboApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flambo"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Flambo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Fired by launcher shortcuts and by automation apps
                 (e.g. Key Mapper hardware-key bindings). -->
            <intent-filter>
                <action android:name="com.flambo.recorder.ACTION_START_RECORDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.flambo.recorder.ACTION_PAUSE_RECORDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Alternate launcher icons (Appearance → App icon). Disabled by
             default; AppIconManager toggles exactly one of them on. Shortcuts
             metadata is repeated so long-press actions work on every icon. -->
        <activity-alias
            android:name=".LauncherIconOutline"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_outline"
            android:roundIcon="@mipmap/ic_launcher_outline"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".LauncherIconDuo"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_duo"
            android:roundIcon="@mipmap/ic_launcher_duo"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- Automation "launch app shortcut" pickers (Key Mapper, Tasker):
             returns a shortcut that toggles via the handler below. Finished
             instantly — no window, no UI, excluded from recents. -->
        <activity
            android:name=".ui.ShortcutConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Transparent trampoline for the shortcut above: mapper runners
             execute shortcuts via startActivity(), which a receiver target
             cannot survive. NoDisplay + empty taskAffinity isolates it so
             the main task is never foregrounded — nothing over lock screen
             and nothing queued for unlock. -->
        <activity
            android:name=".ui.ShortcutHandlerActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <service
            android:name=".record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback|mediaProjection" />

        <!-- Headless automation entry: Key Mapper / Tasker "send broadcast"
             with one of the actions below. Exported on purpose; no activity
             opens and the screen is left alone. -->
        <receiver
            android:name=".record.RecordingReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.flambo.recorder.ACTION_TOGGLE" />
                <action android:name="com.flambo.recorder.ACTION_START" />
                <action android:name="com.flambo.recorder.ACTION_STOP" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
