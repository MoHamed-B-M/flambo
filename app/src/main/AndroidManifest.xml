<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Used only to download offline speech models and check for updates. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".RecordMasterApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RecordMaster">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.RecordMaster">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Fired by launcher shortcuts and by automation apps
                 (e.g. Key Mapper hardware-key bindings). -->
            <intent-filter>
                <action android:name="com.flambo.recorder.ACTION_START_RECORDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.flambo.recorder.ACTION_PAUSE_RECORDING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.flambo.recorder.ACTION_RECORD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.flambo.recorder.ACTION_PAUSE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.flambo.recorder.ACTION_STOP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.flambo.recorder.ACTION_TOGGLE_RECORD_PAUSE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.flambo.recorder.ACTION_TOGGLE_RECORD_STOP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Automation "launch app shortcut" pickers (Key Mapper, Tasker):
             shows the discrete-action picker; the handler below performs it.
             Disabled until the user opts in via Settings -> Automation. -->
        <activity
            android:name=".ui.ShortcutConfigActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.RecordMaster">
            <intent-filter>
                <action android:name="android.intent.action.CREATE_SHORTCUT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Transparent trampoline for the shortcut above: mapper runners
             execute shortcuts via startActivity(), which a receiver target
             cannot survive. NoDisplay + empty taskAffinity isolates it so the
             main task is never foregrounded. -->
        <activity
            android:name=".ui.ShortcutHandlerActivity"
            android:enabled="false"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <service
            android:name=".core.record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".core.stt.WhisperTranscriptionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".core.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Headless automation entry: Key Mapper / Tasker "send broadcast"
             with one of the actions below. Exported on purpose; disabled until
             the user opts in via Settings -> Automation. -->
        <receiver
            android:name=".core.record.RecordingReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="com.flambo.recorder.ACTION_TOGGLE" />
                <action android:name="com.flambo.recorder.ACTION_START" />
                <action android:name="com.flambo.recorder.ACTION_STOP" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>